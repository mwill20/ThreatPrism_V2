THREATPRISM_ENV=demo
DATABASE_URL=sqlite:///./data/threatprism.db
API_AUTH_MODE=demo_key
API_TOKEN=
DEMO_API_KEYS=demo-analyst-key:demo_analyst:analyst,demo-engineer-key:demo_engineer:engineer,demo-manager-key:demo_manager:manager_grc,demo-legal-key:demo_legal:legal_privacy,demo-audit-key:demo_audit:audit_debug,demo-admin-key:demo_admin:admin
THREATPRISM_AUTH_REQUIRED=true
THREATPRISM_LOCAL_DEV_ACK=false
DEMO_ROLE_OVERRIDE_ENABLED=false
# Seed the demo database from hand-reviewed curated fixtures at API startup.
# Local/demo only; refused when THREATPRISM_ENV is prod/production.
THREATPRISM_DEMO_SEED=false
LLM_PROVIDER=deterministic_demo
LOCAL_LLM_BASE_URL=
ALLOW_REAL_ACTIONS=false

# Real-LLM triage (spec 33) — GATED. Keep LLM_PROVIDER=deterministic_demo for demo.
# To open the gate, set LLM_PROVIDER=anthropic_claude and supply the key below.
# Secrets via environment only — never commit real keys.
ANTHROPIC_API_KEY=
LLM_MODEL_ID=claude-sonnet-4-5
LLM_MODEL_REVISION=
LLM_TEMPERATURE=0.2
LLM_CALL_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
SUMMARY_MAX_CHARS=1200
# Governance: usage/cost accounting + spend caps (required for a real provider).
# Set prices per 1M tokens for your model; a cap (cost or tokens) must be > 0.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0
LLM_MAX_COST_USD_PER_RUN=5
LLM_MAX_TOTAL_TOKENS_PER_RUN=2000000
BATCH_MAX_EVENTS=50
BATCH_MAX_INPUT_TOKENS=150000
OUTPUT_TOKEN_RESERVE=4096
# Mock analyst (Evolution 2 grader) — independent provider, OpenAI.
MOCK_ANALYST_PROVIDER=openai
OPENAI_API_KEY=
MOCK_ANALYST_MODEL_ID=gpt-4o-mini
# Independent-analyst pricing for backtest spend governance (spec 36). A different
# model from the triage brain, so it has its own price. gpt-4o-mini standard:
# $0.15 / $0.60 per 1M tokens (input / output). The per-run cap reuses
# LLM_MAX_COST_USD_PER_RUN / LLM_MAX_TOTAL_TOKENS_PER_RUN.
MOCK_ANALYST_INPUT_PRICE_PER_MTOK=0.15
MOCK_ANALYST_OUTPUT_PRICE_PER_MTOK=0.60
# Semantic prompt-injection firewall (spec 32) — GATED, default OFF so the demo
# pipeline is unchanged. Detector, never a gate: it can only escalate. Enabling
# requires a PINNED model revision (a moving tag is rejected) and the gated
# Prompt Guard 2 weights fetched locally (no runtime auto-download, no egress).
# Install transformers from requirements-llm.txt before enabling.
SEMANTIC_FIREWALL_ENABLED=false
SEMANTIC_FIREWALL_MODEL_ID=meta-llama/Llama-Prompt-Guard-2-86M
SEMANTIC_FIREWALL_MODEL_REVISION=
SEMANTIC_FIREWALL_QUARANTINE_THRESHOLD=0.9
SEMANTIC_FIREWALL_REVIEW_THRESHOLD=0.5
# What a high (>= quarantine threshold) semantic score does (spec 32 §9.1):
#   quarantine -> block triage (default; max injection defense)
#   review     -> non-blocking manager-review flag (avoids the measured ~25%
#                 false-positive block on trigger-word SOC text; prefer before any
#                 high-volume/auto-close path). The regex quarantine still blocks.
SEMANTIC_FIREWALL_HIGH_BAND_ACTION=quarantine
MAX_REQUEST_BODY_BYTES=262144
CASE_POST_RATE_LIMIT_PER_MINUTE=60
TRIAGE_CONCURRENCY_LIMIT=4
PRODUCTION_IDENTITY_PROVIDER=
PRODUCTION_IDENTITY_ISSUER=
PRODUCTION_IDENTITY_AUDIENCE=
PRODUCTION_IDENTITY_JWKS_URI=
PRODUCTION_IDENTITY_SUBJECT_CLAIM=sub
PRODUCTION_IDENTITY_ROLES_CLAIM=roles
PRODUCTION_IDENTITY_TENANT_CLAIM=tid
PRODUCTION_IDENTITY_REQUIRED_ROLES=analyst,engineer,manager_grc,legal_privacy,audit_debug,admin
PRODUCTION_IDENTITY_ALLOWED_ALGORITHMS=RS256
PRODUCTION_IDENTITY_LIVE_VERIFICATION_ENABLED=false
PRODUCTION_IDENTITY_ALLOWED_TENANTS=
PRODUCTION_IDENTITY_ROLE_MAPPING=
PRODUCTION_IDENTITY_JWKS_JSON=
PRODUCTION_IDENTITY_JWKS_FETCH_ENABLED=false
PRODUCTION_IDENTITY_CLOCK_SKEW_SECONDS=60
PRODUCTION_IDENTITY_MAX_TOKEN_BYTES=8192
PRODUCTION_IDENTITY_CLAIM_MAPPING_VERSION=local-demo-v1
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
WHOIS_RDAP_PROVIDER=default
